---
interface Props {
  eyebrow: string;
  heading: string;
  description?: string;
}
const { eyebrow, heading, description } = Astro.props;
---

<div class="section-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h2>{heading}</h2>
  {description && <p class="section-description">{description}</p>}
</div>
