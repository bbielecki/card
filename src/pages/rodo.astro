---
import Layout from '../layouts/Layout.astro';
import { Content, frontmatter } from '../content/rodo.md';
import site from '../content/site.json';
---
<Layout title={`${frontmatter.title} — ${site.name}`} description={frontmatter.description} noindex>
  <article class="container section legal-content"><a class="text-link" href="/">← {site.ui.back}</a><p class="eyebrow">RODO</p><h1>{frontmatter.title}</h1><Content /></article>
</Layout>
