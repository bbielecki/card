---
import consultations from '../../content/consultations.json';
import site from '../../content/site.json';
import SectionHeader from '../common/SectionHeader.astro';
import Icon from '../common/Icon.astro';
interface Props { consultation: typeof consultations[number]; }
const { consultation: data } = Astro.props;
---
<section id={data.id} class:list={['section', 'consultation-section', { 'section--soft': data.id === 'telekonsultacja' }]}><div class="container consultation-grid"><div><span class="icon-tile"><Icon name={data.icon} /></span><SectionHeader {...data} /><a class="text-link" href="#kontakt">{data.cta}<Icon /></a></div><div class="consultation-details"><ul>{data.points.map((point, i) => <li><span>0{i + 1}</span><p>{point}</p></li>)}</ul>{site.isDraft && <p class="editorial-note">{data.note}</p>}</div></div></section>
