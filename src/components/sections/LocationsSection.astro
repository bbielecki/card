---
import data from "../../content/locations.json";
import site from "../../content/site.json";
import ContactLinks from "../common/ContactLinks.astro";
---

<div id="lokalizacje" class="location-grid">
  {
    data.items.map((location) => (
      <article class="location-card">
        <div class="location-card__content">
          <h3>{location.name}</h3>

          {location.address && <p class="location-card__address">{location.address}</p>}

          <p>{location.description}</p>
        </div>
        <ContactLinks channel="phone" />
      </article>
    ))
  }

  <div class="location-online">
    <ContactLinks channel="mail" />
    {!site.phone && !site.email && <p class="editorial-note">{site.contact.pending}</p>}
  </div>
</div>
