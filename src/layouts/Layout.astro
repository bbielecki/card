---
import site from "../content/site.json";
import locations from "../content/locations.json";
import services from "../content/services.json";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import "@fontsource/manrope/latin-400.css";
import "@fontsource/manrope/latin-ext-400.css";
import "@fontsource/manrope/latin-500.css";
import "@fontsource/manrope/latin-ext-500.css";
import "@fontsource/manrope/latin-600.css";
import "@fontsource/manrope/latin-ext-600.css";
import "@fontsource/manrope/latin-700.css";
import "@fontsource/manrope/latin-ext-700.css";
import "../styles/global.scss";
import "../styles/hero-interaction.scss";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = site.seoTitle,
  description = site.description,
  noindex = false,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const draft = site.isDraft || !Astro.site || noindex;
const socialImage = new URL("/social-card.png", Astro.site || site.url);
const home = new URL("/", Astro.site || site.url).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      url: home,
      name: site.name,
      inLanguage: "pl-PL",
      about: { "@id": `${home}#person` },
    },
    {
      "@type": "Person",
      "@id": `${home}#person`,
      name: site.name,
      jobTitle: site.title,
      url: home,
      description: site.description,
      knowsAbout: services.items.map((service) => service.title),
      workLocation: locations.items.map((location) => ({
        "@type": "Place",
        name: location.name,
        address: location.address,
      })),
    },
    {
      "@type": "Service",
      "@id": `${home}#physiotherapy`,
      name: site.contact.heading.replaceAll("\n", " "),
      description: site.contact.description,
      provider: { "@id": `${home}#person` },
      areaServed: site.serviceArea.map((name) => ({ "@type": "City", name })),
      url: `${home}#kontakt`,
    },
  ],
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b1f3a" />
    <meta name="description" content={description} />
    <meta name="robots" content={draft ? "noindex, nofollow" : "index, follow"} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${site.name} — ${site.title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {Astro.url.pathname === "/" && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{site.ui.skip}</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
