---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { file: string; alt: string; priority?: boolean; class?: string; }
const { file, alt, priority = false, class: className } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photo = photos[`/src/assets/photos/${file}`]?.default;
if (file && !photo) throw new Error(`Nie znaleziono zdjęcia src/assets/photos/${file}`);
---
{photo && <Image src={photo} alt={alt} class={className} widths={[360, 640, 960]} sizes="(max-width: 767px) 100vw, 50vw" format="webp" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />}
