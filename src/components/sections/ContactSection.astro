---
import site from "../../content/site.json";
import ContactLinks from "../common/ContactLinks.astro";
import SectionHeader from "../common/SectionHeader.astro";
import Icon from "../common/Icon.astro";
---

<section id="kontakt" class="section contact-section">
  <div class="container contact-grid">
    <div>
      <SectionHeader {...site.contact} /><a class="text-link" href="#lokalizacje"
        >{site.contact.locationsLink}<Icon /></a>
    </div><div>
      <ContactLinks />{
        !site.phone && !site.email && <p class="editorial-note">{site.contact.pending}</p>
      }
    </div>
  </div>
</section>
