---
import consultations from "../../content/consultations.json";
import site from "../../content/site.json";
import SectionHeader from "../common/SectionHeader.astro";
import Icon from "../common/Icon.astro";
interface Props {
  consultation: (typeof consultations)[number];
}
const { consultation: data } = Astro.props;
const isOnline = data.id === "telekonsultacja";
---

<section
  id={data.id}
  class:list={[
    "section",
    "consultation-section",
    { "section--navy": data.id === "telekonsultacja" },
  ]}
>
  <div class="container consultation-grid">
    <div>
      <span class="icon-tile"><Icon name={data.icon} /></span><SectionHeader {...data} /><a
        class:list={[isOnline ? "button" : "text-link"]}
        href={isOnline && site.email ? `mailto:${site.email}` : "#kontakt"}
        aria-label={isOnline && site.email ? site.contact.emailActionLabel : undefined}
        >{isOnline && !site.email ? site.ui.contact : data.cta}<Icon /></a
      >
    </div><div class="consultation-details">
      {data.stepsHeading && <h3>{data.stepsHeading}</h3>}
      <ul>
        {
          data.points.map((point, i) => (
            <li>
              <>
                <span>0{i + 1}</span>
                <p>{point}</p>
              </>
            </li>
          ))
        }
      </ul>{site.isDraft && <p class="editorial-note">{data.note}</p>}
    </div>
  </div>
</section>
