---
import site from "../../content/site.json";
import Icon from "./Icon.astro";
interface Props {
  compact?: boolean;
  channel?: "phone" | "mail";
}
const { compact = false, channel } = Astro.props;
const links = [
  {
    label: site.contact.phoneLabel,
    description: site.contact.phoneDescription,
    value: site.phone,
    href: site.phone ? `tel:${site.phone.replace(/[^+\d]/g, "")}` : "",
    pending: site.contact.phonePending,
    icon: "phone",
  },
  {
    label: site.contact.emailLabel,
    description: site.contact.emailDescription,
    value: site.email,
    href: site.email ? `mailto:${site.email}` : "",
    pending: site.contact.emailPending,
    icon: "mail",
  },
];
---

<div class:list={["contact-links", { "contact-links--compact": compact }]}>
  {
    links
      .filter((link) => !channel || link.icon === channel)
      .map((link) => (
        <div class="contact-item">
          <Icon name={link.icon} />
          <div>
            <span class="contact-label">{link.label}</span>
            {link.href && link.icon === "phone" ? (
              <a href={link.href} aria-label={`${link.label}: ${link.value}`}>
                {link.value}
              </a>
            ) : link.href ? (
              <span class="contact-email-value">{link.value}</span>
            ) : (
              <span class="pending-value">{link.pending}</span>
            )}
            <p class="contact-description">{link.description}</p>
            {link.icon === "mail" && link.href && (
              <a
                class="button contact-email-action"
                href={link.href}
                aria-label={site.contact.emailActionLabel}
              >
                {site.ui.email}
                <Icon name="mail" />
              </a>
            )}
          </div>
        </div>
      ))
  }
</div>
